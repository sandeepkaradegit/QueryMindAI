# Copy this file to .env for local development.
# Keep secrets private; never commit .env.

# Primary query database for /query and /admin/schema (when no active admin DB connection overrides it).
QUERYMIND_DATABASE_URL=sqlite:///./data/querymind.sqlite3

# Optional local metadata DB for admin settings/logs. Leave blank to use default data/querymind_admin.sqlite3.
QUERYMIND_ADMIN_DB_PATH=

# Groq generation provider settings.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# The OpenEvals judge model (via Groq). Must support structured JSON output.
GROQ_GUARDRAIL_MODEL=openai/gpt-oss-120b

# Optional Ollama endpoint when provider is set to "ollama" in Model Config.
OLLAMA_BASE_URL=http://localhost:11434

# Query safety/runtime controls.
QUERYMIND_MAX_ROWS=100
QUERYMIND_QUERY_TIMEOUT_SECONDS=5

# Browser origin allowed to call the API with credentials.
QUERYMIND_FRONTEND_ORIGIN=http://localhost:3000

# Admin session lifetime in seconds (default 43200 = 12 hours).
QUERYMIND_SESSION_TTL_SECONDS=

# Optional: only used by scripts/validate_postgres_integration.py against a real PostgreSQL server you control.
QUERYMIND_POSTGRES_TEST_URL=

# LangSmith tracing (optional). Leave API key blank to disable export.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=querymind-ai
